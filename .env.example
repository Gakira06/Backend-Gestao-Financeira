# Usada em runtime (queries) — string do connection pooler (Supavisor), porta 6543
DATABASE_URL="postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Usada só para migrations (prisma migrate) — conexão direta, porta 5432
DIRECT_URL="postgresql://postgres:<senha>@db.<project-ref>.supabase.co:5432/postgres"
PORT=3333
