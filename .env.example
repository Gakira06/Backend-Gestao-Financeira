# Usada em runtime (queries) — Transaction pooler (Supavisor), porta 6543
DATABASE_URL="postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Usada para migrations (prisma migrate) — Session pooler, porta 5432
# OBS: a conexao direta (db.<project-ref>.supabase.co) so resolve por IPv6 e NAO
# funciona em hosts IPv4-only como a Render. Use sempre o Session pooler aqui.
DIRECT_URL="postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres"
PORT=3333
